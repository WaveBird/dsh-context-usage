{
  "name": "@local/dsh-context-usage",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "description": "Context usage report: the /context command and its occupancy panel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mounta1n-18/dsh-context-usage.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-window",
    "token-usage",
    "slash-command"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
